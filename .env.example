NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Combined reasoning + visible output budget: integer 2048–16384; default 4096.
OPENROUTER_MAX_TOKENS=4096
# Optional: only set an effort supported by OPENROUTER_MODEL (e.g. low).
# Blank leaves provider defaults unchanged. No automatic paid retries.
OPENROUTER_REASONING_EFFORT=

# Public AI requires migration 202611120001_public_analysis.sql + reachable Supabase.
# Only openrouter/free or vendor/model:free is accepted. No paid fallback.
# Use a pinned :free model for reproducibility; openrouter/free may change models.
# Cache identity salt: bump when a configured model alias changes behavior.
ANALYSIS_MODEL_VERSION=1
# Required: random server-only secret, >=32 characters. Stable across all replicas.
# Rotation resets per-IP counters; never rotate to bypass the daily limit.
ANALYSIS_IP_HASH_SECRET=
# Required (no implicit localhost/public fallback): single-header OR xff.
# Configure ONLY behind a proxy you control; block direct origin access.
ANALYSIS_IP_STRATEGY=
# single-header: lowercase header that the edge OVERWRITES, never passes through.
# Example x-real-ip only if your proxy actually guarantees overwrite.
ANALYSIS_IP_HEADER=
# xff: number of trusted proxies appending IPs, counted from the RIGHT.
# One trusted proxy appending the actual peer address => 1. No default.
ANALYSIS_TRUSTED_PROXY_HOPS=
