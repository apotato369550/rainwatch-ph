NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Combined reasoning + visible output budget: integer 2048–16384; default 4096.
OPENROUTER_MAX_TOKENS=4096
# Optional: only set an effort supported by OPENROUTER_MODEL (e.g. low).
# Blank leaves provider defaults unchanged. No automatic paid retries.
OPENROUTER_REASONING_EFFORT=
